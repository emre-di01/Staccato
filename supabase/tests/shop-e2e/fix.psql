INSERT INTO schulen (id,name) VALUES ('81111111-1111-1111-1111-111111111111','P');
INSERT INTO auth.users (id,aud,role,email,encrypted_password,created_at,updated_at) SELECT ('8a000000-0000-0000-0000-0000000000'||lpad(n::text,2,'0'))::uuid,'authenticated','authenticated','p'||n||'@t.local','',now(),now() FROM generate_series(1,20) n;
INSERT INTO profiles (id,voller_name,rolle,schule_id,letzte_schule_id) SELECT ('8a000000-0000-0000-0000-0000000000'||lpad(n::text,2,'0'))::uuid,'P'||n,'schueler','81111111-1111-1111-1111-111111111111','81111111-1111-1111-1111-111111111111' FROM generate_series(1,20) n ON CONFLICT (id) DO UPDATE SET schule_id=EXCLUDED.schule_id, letzte_schule_id=EXCLUDED.letzte_schule_id, rolle='schueler';
INSERT INTO schul_mitgliedschaften (user_id,schule_id,rolle,aktiv) SELECT id,'81111111-1111-1111-1111-111111111111','schueler',true FROM profiles WHERE id::text LIKE '8a%' ON CONFLICT DO NOTHING;
INSERT INTO events (id,schule_id,titel,typ,beginn,oeffentlich) VALUES ('83000000-0000-0000-0000-000000000001','81111111-1111-1111-1111-111111111111','E1','konzert',now()+interval '30 days',true),('83000000-0000-0000-0000-000000000002','81111111-1111-1111-1111-111111111111','E2','konzert',now()+interval '30 days',true);
INSERT INTO ticket_einstellungen (event_id,aktiv,kapazitaet,preis_normal,preis_verguenstigt,kontingent,obergrenze) VALUES ('83000000-0000-0000-0000-000000000001',true,7,15,8,3,10),('83000000-0000-0000-0000-000000000002',true,500,15,8,3,10);
