# Integration-Test-Credentials für lokale Supabase-Instanz
# Kopieren nach .env.test und Werte aus `supabase status` eintragen.
# .env.test ist in .gitignore — niemals echte Keys committen.

TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_ANON_KEY=<Publishable Key aus supabase status>
TEST_SUPABASE_SVC_KEY=<Secret Key aus supabase status>
TEST_SCHULE_ID=00000000-0000-0000-0000-000000000001
