VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key aus Supabase Cloud Dashboard>
VITE_VAPID_PUBLIC_KEY=<optional, Web Push>

# DB-URL für Migrationen (kein supabase link nötig)
# Supabase Cloud Dashboard → Project Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
